# Copy to .env for local development.

# Database: "mongo" (default) or "firestore"
FARMIVO_DB_BACKEND=mongo
# Local: docker compose up -d mongo
# Existing server with auth: create a dedicated user for the farmivo database, then
#   mongodb://farmivo_app:<password>@<host>:27017/farmivo?authSource=farmivo
# (special characters in the password must be URL-encoded)
# MongoDB. Fill these fields (no escaping needed, any characters in the password are fine):
FARMIVO_MONGO_HOST=localhost
FARMIVO_MONGO_PORT=27017
FARMIVO_MONGO_USER=
FARMIVO_MONGO_PASSWORD=
# Database the user was created in (db.createUser was run there). Empty = FARMIVO_MONGO_DB.
FARMIVO_MONGO_AUTH_DB=
FARMIVO_MONGO_DB=farmivo
# ...or one connection string instead (overrides the fields above; special characters in the password
# must be URL-encoded, e.g. @ -> %40):
# FARMIVO_MONGO_URI=mongodb://farmivo_app:<password>@127.0.0.1:27017/?authSource=farmivo
# Public URL of this API; used to build photo URLs (photos are always served through /v1/photos/<id>)
FARMIVO_PUBLIC_BASE_URL=http://localhost:8000

# Photos: "gridfs" (inside the Mongo database, default) or "minio" (own bucket on a MinIO server)
FARMIVO_PHOTO_STORE=gridfs
# Only for FARMIVO_PHOTO_STORE=minio. Use a dedicated access key limited to this bucket.
FARMIVO_MINIO_ENDPOINT=localhost:9000
FARMIVO_MINIO_ACCESS_KEY=
FARMIVO_MINIO_SECRET_KEY=
FARMIVO_MINIO_BUCKET=farmivo-photos
FARMIVO_MINIO_SECURE=false

# Firebase is still used for sign-in (Auth) and push notifications (Cloud Messaging) - both free.
FARMIVO_FIREBASE_PROJECT_ID=farmivo-4d932
# Only needed when FARMIVO_DB_BACKEND=firestore
FARMIVO_FIREBASE_STORAGE_BUCKET=

# Service account credentials. On Cloud Run / GCP leave unset to use the runtime service account.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Shared secret for the daily cron job -> POST /v1/internal/reminders/run
FARMIVO_CRON_SECRET=change-me

# Comma separated list of allowed browser origins (mobile apps do not need CORS)
FARMIVO_CORS_ORIGINS=

# development | production
FARMIVO_ENVIRONMENT=development
