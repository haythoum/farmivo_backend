# Farmivo API settings. Copy to .env in this folder (next to app/) and fill in the <...> values:
#   cp .env.example .env && chmod 600 .env
# .env is git-ignored. Never put real passwords or keys in this example file.

# --- Database -----------------------------------------------------------------------
# "mongo" (default) or "firestore"
FARMIVO_DB_BACKEND=mongo
# MongoDB on the same server. The password needs no escaping.
FARMIVO_MONGO_HOST=127.0.0.1
FARMIVO_MONGO_PORT=27017
FARMIVO_MONGO_USER=<mongo user>
FARMIVO_MONGO_PASSWORD=<mongo password>
# Database the user was created in (where db.createUser ran). A dedicated farmivo_app user: farmivo.
# An existing user from another app: that app's database (for example SOSAPP).
FARMIVO_MONGO_AUTH_DB=farmivo
FARMIVO_MONGO_DB=farmivo
# Prefix for Farmivo's collections. Use it when Farmivo shares another app's database, e.g.
# FARMIVO_MONGO_DB=SOSAPP + FARMIVO_MONGO_PREFIX=farmivo_  ->  SOSAPP.farmivo_animals, SOSAPP.farmivo_vaccinations, ...
FARMIVO_MONGO_PREFIX=
# Alternative: one connection string (overrides the fields above; URL-encode special characters, @ -> %40)
# FARMIVO_MONGO_URI=mongodb://<user>:<password>@127.0.0.1:27017/?authSource=farmivo

# --- Public address of this API (used to build photo links the apps open) -------------
FARMIVO_PUBLIC_BASE_URL=http://<server ip or domain>:8000

# --- Photos ---------------------------------------------------------------------------
# "gridfs" (inside MongoDB, default, nothing else to set) or "minio"
FARMIVO_PHOTO_STORE=gridfs
# Only for FARMIVO_PHOTO_STORE=minio (use a dedicated key limited to this bucket):
# FARMIVO_MINIO_ENDPOINT=localhost:9000
# FARMIVO_MINIO_ACCESS_KEY=<access key>
# FARMIVO_MINIO_SECRET_KEY=<secret key>
# FARMIVO_MINIO_BUCKET=farmivo-photos
# FARMIVO_MINIO_SECURE=false

# --- Firebase (checks sign-in tokens, sends push notifications) ------------------------
FARMIVO_FIREBASE_PROJECT_ID=farmivo-4d932
# Only for FARMIVO_DB_BACKEND=firestore
FARMIVO_FIREBASE_STORAGE_BUCKET=
# Service-account key (Firebase console > Project settings > Service accounts > Generate new private key).
# REQUIRED: without it every sign-in token is rejected (401). Absolute path or relative to this folder.
FARMIVO_FIREBASE_CREDENTIALS=<path to serviceAccountKey.json>

# --- Email: the 6-digit code sent after sign-up, through Mailjet ------------------------
# Mailjet > Account settings > API keys. Leave MAILJET_API_KEY empty to test without email:
# the code is then written to the server log (grep "verification code for" /var/log/farmivo.err.log).
MAILJET_API_KEY=<mailjet api key>
MAILJET_API_SECRET=<mailjet secret key>
# Sender: must be validated in Mailjet (Senders & Domains).
FARMIVO_MAIL_FROM_EMAIL=SOSKHEDMA@soskhedma.tn
FARMIVO_MAIL_FROM_NAME=Farmivo
# Key for hashing the codes (openssl rand -hex 24). Empty: FARMIVO_CRON_SECRET is used.
FARMIVO_CODE_SECRET=<random secret>

# --- Daily reminder job: secret for POST /v1/internal/reminders/run (openssl rand -hex 24)
FARMIVO_CRON_SECRET=<random secret>

# Allowed browser origins, comma separated (the mobile apps do not need CORS)
FARMIVO_CORS_ORIGINS=

# development | production
FARMIVO_ENVIRONMENT=production
