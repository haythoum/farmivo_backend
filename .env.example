# Copy to .env for local development.

# Firebase project (Firestore, Auth, Storage, Cloud Messaging)
FARMIVO_FIREBASE_PROJECT_ID=your-firebase-project-id
FARMIVO_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app

# Service account credentials. On Cloud Run / GCP leave unset to use the
# runtime service account (Application Default Credentials).
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Shared secret for Cloud Scheduler -> POST /v1/internal/reminders/run
FARMIVO_CRON_SECRET=change-me

# Comma separated list of allowed browser origins (mobile apps do not need CORS)
FARMIVO_CORS_ORIGINS=

# development | production
FARMIVO_ENVIRONMENT=development
